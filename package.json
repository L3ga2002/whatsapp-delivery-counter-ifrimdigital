{
  "name": "whatsapp-delivery-counter-ifrimdigital",
  "version": "0.3.21",
  "private": true,
  "author": "IfrimDigital",
  "description": "Windows desktop app for counting courier activity from exported WhatsApp chats.",
  "main": "dist-electron/electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/L3ga2002/whatsapp-delivery-counter-ifrimdigital.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"npm run electron:dev:app\"",
    "electron:dev:app": "npm run build:electron && wait-on http://127.0.0.1:3001 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3001 electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "test": "vitest run",
    "prepare:assets": "node tools/generate-icon.mjs",
    "clean:release": "node tools/clean-release.mjs",
    "pack:win": "npm run clean:release && npm run prepare:assets && electron-builder --win --publish never",
    "publish:github": "node tools/publish-github-release.mjs",
    "hash:release": "node tools/hash-release.mjs",
    "verify:release": "npm test -- --run && npm run build && npm run pack:win && npm run hash:release",
    "dist:win": "npm run verify:release"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "ro.ifrimdigital.whatsapp-delivery-counter",
    "productName": "WhatsApp Delivery Counter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "L3ga2002",
        "repo": "whatsapp-delivery-counter-ifrimdigital-releases",
        "private": false,
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "WhatsApp-Delivery-Counter-${version}-Installer-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "WhatsApp-Delivery-Counter-${version}-Portable-${arch}.${ext}"
    }
  }
}
